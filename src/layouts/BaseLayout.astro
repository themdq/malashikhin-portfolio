---
import '@/styles/global.css';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} - ${site.role}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New York City',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  sameAs: site.social.map((item) => item.href),
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf8ee" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const saved = localStorage.getItem('portfolio-theme');
        const theme = saved || 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      const root = document.documentElement;
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeLabel = document.querySelector('[data-theme-label]');

      const syncTheme = (theme) => {
        root.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          'content',
          theme === 'dark' ? '#16130f' : '#fbf8ee',
        );
        if (themeLabel) themeLabel.textContent = theme === 'dark' ? 'Use light theme' : 'Use dark theme';
      };

      syncTheme(root.dataset.theme || 'dark');
      themeButton?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('portfolio-theme', next);
        syncTheme(next);
      });
    </script>
  </body>
</html>
