---
import { site } from '@/data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-copy" data-reveal>
    <h1 id="hero-title"><span>Dmitrii</span><span>Malashikhin</span></h1>
    <p class="hero-role">{site.role}<span aria-hidden="true">_</span></p>
    <p class="hero-description">{site.description}</p>
    <p class="location"><span aria-hidden="true">◎</span>{site.location}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">View selected work <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href={site.resume} download>Download resume <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-socials" aria-label="Social links">
      {site.social.slice(0, 2).map((item) => (
        <a href={item.href} target="_blank" rel="noreferrer">{item.label} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </div>

  <div class="glass-scene" data-glass-scene aria-hidden="true">
    <div class="glass-shape glass-shape-one"></div>
    <div class="glass-shape glass-shape-two"></div>
    <div class="glass-shape glass-shape-three"></div>
    <div class="spectral-line"></div>
  </div>
</section>
