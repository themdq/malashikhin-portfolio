---
import { projects } from '@/data/site';
---

<section class="section glass-panel about-panel" id="about" aria-labelledby="about-title" data-reveal>
  <div class="section-number">01</div>
  <div class="about-copy">
    <h2 id="about-title">About</h2>
    <p>
      I am a data and pipeline engineer with a cybersecurity background. I build and operate data integrations
      end-to-end: researching sources, writing Python connectors, designing ETL, enriching and validating security
      data, and keeping systems stable with pragmatic automation.
    </p>
  </div>
  <div class="about-facts" aria-label="Key facts">
    <span>New York City</span><span>Python</span><span>SQL</span><span>Airflow</span><span>Kubernetes</span>
  </div>
</section>

<section class="section work-section" id="work" aria-labelledby="work-title">
  <div class="section-heading" data-reveal>
    <span class="section-number">02</span>
    <h2 id="work-title">Selected work</h2>
  </div>
  <div class="project-list">
    {projects.map((project) => (
      <article class="project-row glass-frame" data-reveal>
        <div class="project-number">{project.number}</div>
        <div class="project-main">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
        <p class="project-stack">{project.technologies.join(' · ')}</p>
        <div class="project-links">
          {project.demo && <a href={project.demo} target="_blank" rel="noreferrer">Live site ↗</a>}
          <a href={project.href} target="_blank" rel="noreferrer">View project ↗</a>
        </div>
      </article>
    ))}
  </div>
</section>
