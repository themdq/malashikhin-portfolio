<canvas class="liquid-glass-canvas" data-liquid-glass-canvas aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-liquid-glass-canvas]');

  if (canvas) {
    const gl = canvas.getContext('webgl2', {
      alpha: false,
      antialias: false,
      depth: false,
      powerPreference: 'high-performance',
      premultipliedAlpha: false,
    });

    const vertexSource = `#version 300 es
      in vec2 aPosition;
      out vec2 vUv;
      void main() {
        vUv = aPosition * 0.5 + 0.5;
        gl_Position = vec4(aPosition, 0.0, 1.0);
      }
    `;

    const fragmentSource = `#version 300 es
      precision highp float;

      #define MAX_SURFACES 24

      in vec2 vUv;
      out vec4 outColor;

      uniform vec2 uResolution;
      uniform vec2 uPointer;
      uniform float uTheme;
      uniform int uSurfaceCount;
      uniform vec4 uSurfaces[MAX_SURFACES];
      uniform vec4 uStyles[MAX_SURFACES];

      float roundedRect(vec2 p, vec2 halfSize, float radius) {
        vec2 q = abs(p) - halfSize + radius;
        return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
      }

      vec3 backgroundAt(vec2 uv) {
        vec3 lightBase = vec3(1.0, 0.988, 0.941);
        vec3 darkBase = vec3(0.055, 0.052, 0.050);
        vec3 color = mix(lightBase, darkBase, uTheme);

        float warmWave = exp(-pow((uv.y - (0.17 + 0.08 * sin(uv.x * 5.2))) * 8.0, 2.0));
        float coolWave = exp(-pow((uv.y - (0.78 + 0.07 * sin(uv.x * 4.0 + 1.8))) * 9.0, 2.0));
        float sideGlow = exp(-length((uv - vec2(0.12, 0.54)) * vec2(2.2, 0.8)) * 3.0);
        vec3 warm = mix(vec3(0.82, 0.30, 0.06), vec3(0.94, 0.40, 0.10), uTheme);
        vec3 cool = mix(vec3(0.35, 0.44, 0.50), vec3(0.24, 0.34, 0.43), uTheme);
        color = mix(color, warm, warmWave * mix(0.055, 0.095, uTheme));
        color = mix(color, cool, coolWave * mix(0.035, 0.075, uTheme));
        color = mix(color, warm, sideGlow * mix(0.035, 0.065, uTheme));

        float lineA = abs(sin((uv.x * 1.15 + uv.y * 0.48) * 56.0));
        float lineB = abs(sin((uv.x * 0.42 - uv.y * 1.1) * 44.0));
        float lines = smoothstep(0.965, 0.995, max(lineA, lineB));
        float edgeMask = smoothstep(0.24, 0.0, abs(uv.x - 0.5)) * 0.25 + 0.75;
        color = mix(color, mix(vec3(0.68), vec3(0.28), uTheme), lines * 0.012 * edgeMask);
        return color;
      }

      vec3 glassColor(vec2 screenPx, vec2 screenUv, vec4 rect, vec4 style, vec3 base) {
        vec2 center = rect.xy + rect.zw * 0.5;
        vec2 halfSize = rect.zw * 0.5;
        float radius = min(style.x, min(halfSize.x, halfSize.y) - 1.0);
        vec2 local = screenPx - center;
        float sd = roundedRect(local, halfSize, radius);
        float bezel = clamp(style.y, 8.0, min(radius, min(halfSize.x, halfSize.y)));
        float inside = smoothstep(1.0, -1.0, sd);
        float edge = (1.0 - smoothstep(0.0, bezel, -sd)) * inside;

        vec2 grad = normalize(vec2(
          roundedRect(local + vec2(0.7, 0.0), halfSize, radius) - sd,
          roundedRect(local + vec2(0.0, 0.7), halfSize, radius) - sd
        ) + vec2(0.0001));

        float displacement = edge * style.z;
        vec2 refractedUv = screenUv - grad * displacement / uResolution;
        vec3 refracted = backgroundAt(refractedUv);

        vec2 pointerDir = normalize(uPointer - screenPx + vec2(0.001));
        float pointerLight = pow(max(dot(-grad, pointerDir), 0.0), 2.2);
        float fixedLight = pow(max(dot(-grad, normalize(vec2(-0.62, -0.78))), 0.0), 2.0);
        float highlight = edge * (fixedLight * 0.65 + pointerLight * 0.55);
        float innerShade = edge * pow(max(dot(grad, normalize(vec2(0.55, 0.83))), 0.0), 1.7);

        vec3 tint = style.w < 0.5
          ? mix(vec3(1.0, 0.99, 0.95), vec3(0.15, 0.14, 0.13), uTheme)
          : style.w < 1.5
            ? mix(vec3(0.76, 0.23, 0.045), vec3(0.52, 0.16, 0.035), uTheme)
            : mix(vec3(1.0, 0.72, 0.43), vec3(0.76, 0.31, 0.08), uTheme);

        float tintStrength = style.w < 0.5 ? mix(0.20, 0.34, uTheme) : style.w < 1.5 ? 0.72 : 0.42;
        vec3 color = mix(refracted, tint, tintStrength);
        color += highlight * mix(vec3(0.28, 0.34, 0.40), vec3(0.34, 0.28, 0.22), uTheme);
        color -= innerShade * 0.075;

        float chroma = edge * 0.018;
        color.r += chroma * fixedLight;
        color.b += chroma * (1.0 - fixedLight);

        float shadow = exp(-max(sd, 0.0) * max(sd, 0.0) / 240.0) * (1.0 - inside) * 0.18;
        base *= 1.0 - shadow;
        return mix(base, color, inside);
      }

      void main() {
        vec2 screenPx = vec2(vUv.x, 1.0 - vUv.y) * uResolution;
        vec2 screenUv = screenPx / uResolution;
        vec3 color = backgroundAt(screenUv);

        for (int i = 0; i < MAX_SURFACES; i++) {
          if (i >= uSurfaceCount) break;
          color = glassColor(screenPx, screenUv, uSurfaces[i], uStyles[i], color);
        }

        outColor = vec4(color, 1.0);
      }
    `;

    const compile = (type: number, source: string) => {
      const shader = gl?.createShader(type);
      if (!gl || !shader) return null;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.warn('Liquid glass shader failed:', gl.getShaderInfoLog(shader));
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    };

    const vertex = gl && compile(gl.VERTEX_SHADER, vertexSource);
    const fragment = gl && compile(gl.FRAGMENT_SHADER, fragmentSource);
    const program = gl?.createProgram();

    if (gl && vertex && fragment && program) {
      gl.attachShader(program, vertex);
      gl.attachShader(program, fragment);
      gl.linkProgram(program);

      if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
        const position = gl.getAttribLocation(program, 'aPosition');
        const buffer = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
        gl.useProgram(program);

        const resolutionLocation = gl.getUniformLocation(program, 'uResolution');
        const pointerLocation = gl.getUniformLocation(program, 'uPointer');
        const themeLocation = gl.getUniformLocation(program, 'uTheme');
        const countLocation = gl.getUniformLocation(program, 'uSurfaceCount');
        const surfacesLocation = gl.getUniformLocation(program, 'uSurfaces');
        const stylesLocation = gl.getUniformLocation(program, 'uStyles');
        const surfaces = new Float32Array(24 * 4);
        const styles = new Float32Array(24 * 4);
        const targetPointer = { x: innerWidth * 0.68, y: innerHeight * 0.18 };
        const pointer = { ...targetPointer };
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
        const finePointer = matchMedia('(pointer: fine)');
        let frame = 0;
        let animating = false;

        const surfaceType = (element: HTMLElement) => {
          const type = element.dataset.liquidGlass;
          if (type === 'amber') return 1;
          if (type === 'accent') return 2;
          return 0;
        };

        const collectSurfaces = () => {
          let count = 0;
          document.querySelectorAll<HTMLElement>('[data-liquid-glass]').forEach((element) => {
            if (count >= 24 || element.hidden || getComputedStyle(element).display === 'none') return;
            if (element.hasAttribute('data-liquid-glass-active') && !element.classList.contains('is-active')) return;
            const rect = element.getBoundingClientRect();
            if (rect.width < 2 || rect.height < 2 || rect.bottom < -48 || rect.top > innerHeight + 48) return;
            const radius = Math.min(parseFloat(getComputedStyle(element).borderRadius) || 24, rect.width / 2, rect.height / 2);
            const index = count * 4;
            surfaces.set([rect.left, rect.top, rect.width, rect.height], index);
            const type = surfaceType(element);
            const bezel = type === 1 ? 42 : Math.min(32, radius);
            const displacement = type === 2 ? 18 : type === 1 ? 24 : 14;
            styles.set([radius, bezel, displacement, type], index);
            count += 1;
          });
          return count;
        };

        const draw = () => {
          frame = 0;
          const ratio = Math.min(devicePixelRatio || 1, innerWidth < 780 ? 1.35 : 1.75);
          const width = Math.round(innerWidth * ratio);
          const height = Math.round(innerHeight * ratio);
          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
            canvas.style.width = `${innerWidth}px`;
            canvas.style.height = `${innerHeight}px`;
          }
          gl.viewport(0, 0, width, height);

          const count = collectSurfaces();
          gl.uniform2f(resolutionLocation, innerWidth, innerHeight);
          gl.uniform2f(pointerLocation, pointer.x, pointer.y);
          gl.uniform1f(themeLocation, document.documentElement.dataset.theme === 'dark' ? 1 : 0);
          gl.uniform1i(countLocation, count);
          gl.uniform4fv(surfacesLocation, surfaces);
          gl.uniform4fv(stylesLocation, styles);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          document.documentElement.classList.add('liquid-glass-ready');
        };

        const requestDraw = () => {
          if (!frame && !document.hidden) frame = requestAnimationFrame(draw);
        };

        const animatePointer = () => {
          const dx = targetPointer.x - pointer.x;
          const dy = targetPointer.y - pointer.y;
          pointer.x += dx * 0.11;
          pointer.y += dy * 0.11;
          requestDraw();
          if (Math.abs(dx) + Math.abs(dy) > 0.5) requestAnimationFrame(animatePointer);
          else animating = false;
        };

        addEventListener('pointermove', (event) => {
          if (reducedMotion.matches || !finePointer.matches) return;
          targetPointer.x = event.clientX;
          targetPointer.y = event.clientY;
          if (!animating) {
            animating = true;
            requestAnimationFrame(animatePointer);
          }
        }, { passive: true });

        const observer = new ResizeObserver(requestDraw);
        document.querySelectorAll<HTMLElement>('[data-liquid-glass]').forEach((element) => observer.observe(element));
        const mutationObserver = new MutationObserver(requestDraw);
        mutationObserver.observe(document.documentElement, { attributes: true, subtree: true, attributeFilter: ['class', 'hidden', 'data-theme'] });
        addEventListener('resize', requestDraw, { passive: true });
        addEventListener('scroll', requestDraw, { passive: true });
        addEventListener('load', requestDraw, { once: true });
        document.addEventListener('visibilitychange', requestDraw);
        canvas.addEventListener('webglcontextlost', (event) => {
          event.preventDefault();
          document.documentElement.classList.remove('liquid-glass-ready');
        });
        canvas.addEventListener('webglcontextrestored', requestDraw);
        requestDraw();
      }
    }
  }
</script>

<style>
  .liquid-glass-canvas {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: block;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }
</style>
