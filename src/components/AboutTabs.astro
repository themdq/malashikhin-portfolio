---
import { capabilities, education, experience, interests, site } from '@/data/site';

const tabs = [
  { id: 'background', label: 'Background' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'interests', label: 'Interests' },
] as const;
---

<div class="about-tabs" data-tabs>
  <div class="tab-list" role="tablist" aria-label="About Dmitrii">
    <span class="tab-indicator" aria-hidden="true" data-tab-indicator></span>
    {tabs.map((tab, index) => (
      <button
        id={`tab-${tab.id}`}
        class:list={{ 'is-active': index === 0 }}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <section class="tab-panel prose-panel" id="panel-background" role="tabpanel" aria-labelledby="tab-background" data-panel="background">
    <p>
      I’m Dmitrii Malashikhin, a data and pipeline engineer based in {site.location}. I build and operate data
      integrations end-to-end, from researching sources and writing Python connectors to designing ETL pipelines,
      enrichment, validation, and production support.
    </p>
    <p>
      Most recently, I owned vulnerability data feeds for a cybersecurity product and improved the automation,
      developer tooling, CI/CD, and data-quality workflows around them. I prefer pragmatic systems that are easy to
      understand, test, and keep reliable.
    </p>
    <p>
      Outside work, I follow combat sports and basketball, swim, rollerblade, listen to indie music, and enjoy
      books, films, photography, good coffee, and simplifying everyday routines through automation.
    </p>
  </section>

  <section class="tab-panel experience-panel" id="panel-experience" role="tabpanel" aria-labelledby="tab-experience" data-panel="experience" hidden>
    {experience.map((item) => (
      <article class="experience-item">
        <div class="experience-heading">
          <div><strong>{item.role}</strong><span>{item.company}</span></div>
          <time>{item.period}</time>
        </div>
        <p>{item.summary}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel education-panel" id="panel-education" role="tabpanel" aria-labelledby="tab-education" data-panel="education" hidden>
    {education.map((school) => (
    <article>
      <h2>{school.degree}</h2>
      <p>{school.school} <span>//</span> {school.period}</p>
    </article>
    ))}
  </section>

  <section class="tab-panel skills-panel" id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" data-panel="skills" hidden>
    {capabilities.map((group) => (
      <article>
        <h2>{group.title}</h2>
        <p>{group.items.join(' / ')}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel interests-panel" id="panel-interests" role="tabpanel" aria-labelledby="tab-interests" data-panel="interests" hidden>
    {interests.map((item) => <span>{item}</span>)}
  </section>
</div>

<script>
  const tabRoot = document.querySelector('[data-tabs]');
  const tabButtons = Array.from(tabRoot?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const panels = Array.from(tabRoot?.querySelectorAll<HTMLElement>('[role="tabpanel"]') ?? []);
  const indicator = tabRoot?.querySelector<HTMLElement>('[data-tab-indicator]');

  const moveIndicator = (button: HTMLButtonElement, animate = true) => {
    if (!indicator) return;
    indicator.classList.toggle('is-ready', animate);
    indicator.style.setProperty('--indicator-x', `${button.offsetLeft}px`);
    indicator.style.setProperty('--indicator-y', `${button.offsetTop}px`);
    indicator.style.setProperty('--indicator-width', `${button.offsetWidth}px`);
    indicator.style.setProperty('--indicator-height', `${button.offsetHeight}px`);
    if (!animate) requestAnimationFrame(() => indicator.classList.add('is-ready'));
  };

  const activateTab = (id: string | undefined, animate = true) => {
    if (!tabButtons.some((button) => button.dataset.tab === id)) id = 'background';
    const activeButton = tabButtons.find((button) => button.dataset.tab === id);
    tabButtons.forEach((button) => {
      const active = button.dataset.tab === id;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
    if (activeButton) moveIndicator(activeButton, animate);
  };

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateTab(button.dataset.tab));
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowLeft') next = (index - 1 + tabButtons.length) % tabButtons.length;
      if (event.key === 'ArrowRight') next = (index + 1) % tabButtons.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabButtons.length - 1;
      tabButtons[next].focus();
      activateTab(tabButtons[next].dataset.tab);
    });
  });

  activateTab('background', false);
  requestAnimationFrame(() => indicator?.classList.add('is-ready'));
  addEventListener('resize', () => {
    const activeButton = tabButtons.find((button) => button.classList.contains('is-active'));
    if (activeButton) moveIndicator(activeButton, false);
  }, { passive: true });
</script>

<style>
  .about-tabs { width: min(990px, 100%); margin: 0 auto; }

  .tab-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 10px 18px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: linear-gradient(180deg, var(--glass-hover), var(--glass));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 34px var(--glass-shadow);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .tab-indicator {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: var(--indicator-width, 0px);
    height: var(--indicator-height, 0px);
    border: 1px solid color-mix(in srgb, var(--orange) 58%, var(--glass-border));
    border-radius: 999px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--orange-soft) 76%, white), var(--orange-soft));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 -1px 0 rgba(157, 67, 16, .12), 0 5px 12px var(--glass-shadow);
    pointer-events: none;
    transform: translate3d(var(--indicator-x, 0px), var(--indicator-y, 0px), 0);
  }

  .tab-indicator.is-ready {
    transition: width 460ms cubic-bezier(.22, 1, .36, 1), height 460ms cubic-bezier(.22, 1, .36, 1), transform 460ms cubic-bezier(.22, 1, .36, 1);
  }

  :global(:root[data-theme='dark']) .tab-indicator {
    background: linear-gradient(180deg, rgba(218, 112, 44, .34), rgba(64, 32, 13, .7));
  }

  .tab-list button {
    position: relative;
    z-index: 1;
    padding: 5px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--fs-title);
    cursor: pointer;
    transition: color 180ms ease;
  }

  .tab-list button.is-active {
    color: var(--ink);
  }

  .tab-list button:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  .tab-panel {
    margin-top: 18px;
    border: 1px solid var(--glass-border);
    border-radius: 38px;
    background: linear-gradient(145deg, var(--glass-hover), var(--glass));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 34px var(--glass-shadow);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .tab-panel[hidden] { display: none; }
  .prose-panel { padding: 36px 28px; }
  .prose-panel p { margin: 0; }
  .prose-panel p + p { margin-top: 24px; }
  .experience-panel { padding: 20px 62px; }
  .experience-item { padding: 22px 6px 30px; }
  .experience-item + .experience-item { border-top: 1px dashed var(--line); }
  .experience-heading { display: flex; justify-content: space-between; gap: 24px; }
  .experience-heading div { display: grid; min-width: 0; }
  .experience-heading strong { font-family: var(--serif); font-weight: 400; font-size: var(--fs-title); }
  .experience-heading time::before { content: '// '; }
  .experience-item p { margin: 20px 0 0; font-size: var(--fs-sm); }
  .education-panel { padding: 26px 40px; }
  .education-panel article { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .education-panel h2, .skills-panel h2 { margin: 0; font-family: var(--serif); font-size: var(--fs-title); font-weight: 400; }
  .education-panel p { margin: 0; color: var(--muted); font-size: var(--fs-xs); }
  .skills-panel { display: grid; grid-template-columns: repeat(3, 1fr); padding: 30px 38px; }
  .skills-panel article { padding: 8px 24px; }
  .skills-panel article + article { border-left: 1px dashed var(--line); }
  .skills-panel p { margin: 12px 0 0; color: var(--muted); font-size: var(--fs-sm); }
  .interests-panel { display: flex; flex-wrap: wrap; gap: 12px; padding: 34px; }

  .interests-panel span {
    padding: 7px 13px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 4px 10px transparent;
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .interests-panel span:hover {
    background: var(--glass-hover);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 8px 16px var(--glass-shadow);
    transform: translateY(-2px);
  }

  @media (max-width: 1020px) {
    .tab-list button { font-size: var(--fs-lg); }
  }

  @media (max-width: 780px) {
    .tab-list {
      display: flex;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 24px;
      scrollbar-width: none;
    }

    .tab-list::-webkit-scrollbar { display: none; }
    .tab-list button { flex: 0 0 auto; padding-right: 8px; padding-left: 8px; font-size: var(--fs-sm); }
    .tab-panel { border-radius: 28px; }
    .prose-panel, .experience-panel { padding: 26px 22px; }
    .experience-heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 14px;
      row-gap: 2px;
      align-items: baseline;
    }
    .experience-heading div { display: contents; }
    .experience-heading strong { grid-column: 1; min-width: 0; }
    .experience-heading span { grid-column: 1 / -1; min-width: 0; }
    .experience-heading time {
      grid-column: 2;
      grid-row: 1;
      white-space: nowrap;
      font-size: var(--fs-xs);
    }
    .skills-panel { grid-template-columns: 1fr; }
    .skills-panel article + article { border-top: 1px dashed var(--line); border-left: 0; }
    .education-panel article { display: grid; gap: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-indicator.is-ready { transition: none; }
  }
</style>
