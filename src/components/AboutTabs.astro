---
import { capabilities, education, experience, interests, site } from '@/data/site';

const tabs = [
  { id: 'background', label: 'Background' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'interests', label: 'Interests' },
] as const;
---

<div class="about-tabs" data-tabs>
  <div class="tab-list" role="tablist" aria-label="About Dmitrii">
    {tabs.map((tab, index) => (
      <button
        id={`tab-${tab.id}`}
        class:list={{ 'is-active': index === 0 }}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        <span>{String(index + 1).padStart(2, '0')}</span>{tab.label}
      </button>
    ))}
  </div>

  <section class="tab-panel prose-panel" id="panel-background" role="tabpanel" aria-labelledby="tab-background" data-panel="background">
    <p>
      I’m Dmitrii Malashikhin, a data and pipeline engineer based in {site.location}. I build data integrations
      end-to-end, from researching sources and writing Python connectors to designing ETL pipelines and validation.
    </p>
    <p>
      Most recently, I owned vulnerability data feeds for a cybersecurity product and improved the automation,
      developer tooling, CI/CD, and data-quality workflows around them.
    </p>
    <p>
      I prefer pragmatic systems that are easy to understand, test, and keep reliable as requirements and inputs change.
    </p>
  </section>

  <section class="tab-panel experience-panel" id="panel-experience" role="tabpanel" aria-labelledby="tab-experience" data-panel="experience" hidden>
    {experience.map((item, index) => (
      <article class="experience-item">
        <span class="row-index">{String(index + 1).padStart(2, '0')}:</span>
        <div><strong>{item.role}</strong><span>{item.company}</span></div>
        <time>{item.period}</time>
        <p>{item.summary}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel education-panel" id="panel-education" role="tabpanel" aria-labelledby="tab-education" data-panel="education" hidden>
    {education.map((school, index) => (
      <article>
        <span class="row-index">{String(index + 1).padStart(2, '0')}:</span>
        <h3>{school.degree}</h3>
        <p>{school.school} <span>//</span> {school.period}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel skills-panel" id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" data-panel="skills" hidden>
    {capabilities.map((group, index) => (
      <article>
        <span class="row-index">{String(index + 1).padStart(2, '0')}:</span>
        <h3>{group.title}</h3>
        <p>{group.items.join(' / ')}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel interests-panel" id="panel-interests" role="tabpanel" aria-labelledby="tab-interests" data-panel="interests" hidden>
    {interests.map((item, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{item}</span>)}
  </section>
</div>

<script>
  const tabRoot = document.querySelector('[data-tabs]');
  const tabButtons = Array.from(tabRoot?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const panels = Array.from(tabRoot?.querySelectorAll<HTMLElement>('[role="tabpanel"]') ?? []);

  const activateTab = (id: string | undefined) => {
    if (!tabButtons.some((button) => button.dataset.tab === id)) id = 'background';
    tabButtons.forEach((button) => {
      const active = button.dataset.tab === id;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
  };

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateTab(button.dataset.tab));
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowLeft') next = (index - 1 + tabButtons.length) % tabButtons.length;
      if (event.key === 'ArrowRight') next = (index + 1) % tabButtons.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabButtons.length - 1;
      tabButtons[next].focus();
      activateTab(tabButtons[next].dataset.tab);
    });
  });
</script>

<style>
  .about-tabs { width: 100%; }

  .tab-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .tab-list button {
    display: flex;
    min-width: 0;
    min-height: 58px;
    align-items: center;
    gap: 10px;
    justify-content: center;
    padding: 10px 14px;
    border: 0;
    border-right: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: var(--fs-sm);
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .tab-list button:last-child { border-right: 0; }
  .tab-list button span { color: var(--blue); font-size: var(--fs-xs); }
  .tab-list button:hover { background: var(--surface); }
  .tab-list button.is-active { background: var(--ink); color: var(--page); }
  .tab-list button.is-active span { color: var(--orange); }

  .tab-panel { min-height: 260px; }
  .tab-panel[hidden] { display: none; }

  .prose-panel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .prose-panel p {
    margin: 0;
    padding: clamp(28px, 3.5vw, 56px);
    border-right: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: clamp(22px, 2.1vw, 34px);
    line-height: 1.08;
  }

  .prose-panel p:last-child { border-right: 0; }

  .experience-item {
    display: grid;
    grid-template-columns: 52px minmax(180px, .8fr) 180px minmax(260px, 1.4fr);
    gap: 24px;
    align-items: start;
    padding: 28px var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .experience-item:last-child { border-bottom: 0; }
  .row-index { color: var(--blue); font-size: var(--fs-xs); font-weight: 600; }
  .experience-item div { display: grid; gap: 2px; }
  .experience-item strong { font-family: var(--serif); font-size: 28px; font-weight: 400; line-height: 1; }
  .experience-item div span, .experience-item time { color: var(--muted); font-size: var(--fs-xs); text-transform: uppercase; }
  .experience-item p { margin: 0; color: var(--ink-soft); font-size: var(--fs-sm); }

  .education-panel article, .skills-panel article {
    display: grid;
    grid-template-columns: 52px minmax(220px, .9fr) minmax(260px, 1fr);
    gap: 24px;
    align-items: center;
    padding: 30px var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .education-panel article:last-child, .skills-panel article:last-child { border-bottom: 0; }
  .education-panel h3, .skills-panel h3 { margin: 0; font-family: var(--serif); font-size: 30px; font-weight: 400; }
  .education-panel p, .skills-panel p { margin: 0; color: var(--muted); font-size: var(--fs-xs); text-transform: uppercase; }
  .education-panel p span { color: var(--orange); }

  .interests-panel {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .interests-panel > span {
    display: grid;
    min-height: 130px;
    align-content: space-between;
    padding: 22px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 25px;
  }

  .interests-panel > span:nth-child(5n) { border-right: 0; }
  .interests-panel b { color: var(--blue); font-family: var(--mono); font-size: var(--fs-xs); }

  @media (max-width: 900px) {
    .tab-list { display: flex; overflow-x: auto; scrollbar-width: none; }
    .tab-list::-webkit-scrollbar { display: none; }
    .tab-list button { flex: 0 0 auto; justify-content: flex-start; }
    .prose-panel { grid-template-columns: 1fr; }
    .prose-panel p { border-right: 0; border-bottom: 1px solid var(--line); }
    .prose-panel p:last-child { border-bottom: 0; }
    .experience-item { grid-template-columns: 40px 1fr auto; }
    .experience-item p { grid-column: 2 / -1; }
    .education-panel article, .skills-panel article { grid-template-columns: 40px 1fr; }
    .education-panel p, .skills-panel p { grid-column: 2; }
    .interests-panel { grid-template-columns: repeat(2, 1fr); }
    .interests-panel > span:nth-child(5n) { border-right: 1px solid var(--line); }
    .interests-panel > span:nth-child(2n) { border-right: 0; }
  }

  @media (max-width: 560px) {
    .tab-panel { min-height: 0; }
    .experience-item { grid-template-columns: 32px 1fr; padding: 24px var(--gutter); }
    .experience-item time, .experience-item p { grid-column: 2; }
    .experience-item time { grid-row: 2; }
    .prose-panel p { font-size: 24px; }
  }
</style>
