---
import { capabilities, education, experience, interests, site } from '@/data/site';

const tabs = [
  { id: 'background', label: 'Background' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'interests', label: 'Interests' },
] as const;
---

<div class="about-tabs" data-tabs>
  <div class="tab-list" role="tablist" aria-label="About Dmitrii" data-liquid-glass="clear">
    {tabs.map((tab, index) => (
      <button
        id={`tab-${tab.id}`}
        class:list={{ 'is-active': index === 0 }}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${tab.id}`}
        tabindex={index === 0 ? 0 : -1}
        data-tab={tab.id}
        data-liquid-glass="accent"
        data-liquid-glass-active
      >
        {tab.label}
      </button>
    ))}
  </div>

  <section class="tab-panel prose-panel" id="panel-background" role="tabpanel" aria-labelledby="tab-background" data-panel="background" data-liquid-glass="clear">
    <p>
      I’m Dmitrii Malashikhin, a data and pipeline engineer based in {site.location}. I build and operate data
      integrations end-to-end, from researching sources and writing Python connectors to designing ETL pipelines,
      enrichment, validation, and production support.
    </p>
    <p>
      Most recently, I owned vulnerability data feeds for a cybersecurity product and improved the automation,
      developer tooling, CI/CD, and data-quality workflows around them. I prefer pragmatic systems that are easy to
      understand, test, and keep reliable.
    </p>
    <p>
      Outside work, I follow combat sports and basketball, swim, rollerblade, listen to electronic music, and enjoy
      books, films, photography, good coffee, and simplifying everyday routines through automation.
    </p>
  </section>

  <section class="tab-panel experience-panel" id="panel-experience" role="tabpanel" aria-labelledby="tab-experience" data-panel="experience" data-liquid-glass="clear" hidden>
    {experience.map((item) => (
      <article class="experience-item">
        <div class="experience-heading">
          <div><strong>{item.role}</strong><span>{item.company}</span></div>
          <time>{item.period}</time>
        </div>
        <p>{item.summary}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel education-panel" id="panel-education" role="tabpanel" aria-labelledby="tab-education" data-panel="education" data-liquid-glass="clear" hidden>
    {education.map((school) => (
    <article>
      <h2>{school.degree}</h2>
      <p>{school.school} <span>//</span> {school.period}</p>
    </article>
    ))}
  </section>

  <section class="tab-panel skills-panel" id="panel-skills" role="tabpanel" aria-labelledby="tab-skills" data-panel="skills" data-liquid-glass="clear" hidden>
    {capabilities.map((group) => (
      <article>
        <h2>{group.title}</h2>
        <p>{group.items.join(' / ')}</p>
      </article>
    ))}
  </section>

  <section class="tab-panel interests-panel" id="panel-interests" role="tabpanel" aria-labelledby="tab-interests" data-panel="interests" data-liquid-glass="clear" hidden>
    {interests.map((item) => <span>{item}</span>)}
  </section>
</div>

<script>
  const tabRoot = document.querySelector('[data-tabs]');
  const tabButtons = Array.from(tabRoot?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
  const panels = Array.from(tabRoot?.querySelectorAll<HTMLElement>('[role="tabpanel"]') ?? []);

  const activateTab = (id: string | undefined) => {
    if (!tabButtons.some((button) => button.dataset.tab === id)) id = 'background';
    tabButtons.forEach((button) => {
      const active = button.dataset.tab === id;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== id; });
  };

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => activateTab(button.dataset.tab));
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let next = index;
      if (event.key === 'ArrowLeft') next = (index - 1 + tabButtons.length) % tabButtons.length;
      if (event.key === 'ArrowRight') next = (index + 1) % tabButtons.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabButtons.length - 1;
      tabButtons[next].focus();
      activateTab(tabButtons[next].dataset.tab);
    });
  });

  activateTab('background');
</script>

<style>
  .about-tabs { width: min(990px, 100%); margin: 0 auto; }

  .tab-list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 10px 18px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: linear-gradient(180deg, var(--glass-hover), var(--glass));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 34px var(--glass-shadow);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .tab-list button {
    padding: 5px 12px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 24px;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .tab-list button:hover {
    border-color: var(--glass-border);
    background: var(--glass-hover);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 6px 14px var(--glass-shadow);
    transform: translateY(-1px);
  }

  .tab-list button.is-active {
    border-color: color-mix(in srgb, var(--orange) 58%, var(--glass-border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--orange-soft) 76%, white), var(--orange-soft));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 -1px 0 rgba(157, 67, 16, .12), 0 5px 12px var(--glass-shadow);
  }

  :global(:root[data-theme='dark']) .tab-list button.is-active {
    background: linear-gradient(180deg, rgba(218, 112, 44, .34), rgba(64, 32, 13, .7));
  }

  .tab-panel {
    margin-top: 18px;
    border: 1px solid var(--glass-border);
    border-radius: 38px;
    background: linear-gradient(145deg, var(--glass-hover), var(--glass));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 34px var(--glass-shadow);
    backdrop-filter: blur(18px) saturate(125%);
  }

  .tab-panel[hidden] { display: none; }
  .prose-panel { padding: 36px 28px; }
  .prose-panel p { margin: 0; }
  .prose-panel p + p { margin-top: 24px; }
  .experience-panel { padding: 20px 62px; }
  .experience-item { padding: 22px 6px 30px; }
  .experience-item + .experience-item { border-top: 1px dashed var(--line); }
  .experience-heading { display: flex; justify-content: space-between; gap: 24px; }
  .experience-heading div { display: grid; }
  .experience-heading strong { font-family: var(--serif); font-weight: 400; }
  .experience-heading time::before { content: '// '; }
  .experience-item p { margin: 20px 0 0; font-size: 14px; }
  .education-panel { padding: 26px 40px; }
  .education-panel article { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .education-panel h2, .skills-panel h2 { margin: 0; font-family: var(--serif); font-size: 27px; font-weight: 400; }
  .education-panel p { margin: 0; color: var(--muted); font-size: 11px; }
  .skills-panel { display: grid; grid-template-columns: repeat(3, 1fr); padding: 30px 38px; }
  .skills-panel article { padding: 8px 26px; }
  .skills-panel article + article { border-left: 1px dashed var(--line); }
  .skills-panel p { margin: 12px 0 0; color: var(--muted); font-size: 13px; }
  .interests-panel { display: flex; flex-wrap: wrap; gap: 12px; padding: 34px; }

  .interests-panel span {
    padding: 7px 13px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 4px 10px transparent;
    transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .interests-panel span:hover {
    background: var(--glass-hover);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 8px 16px var(--glass-shadow);
    transform: translateY(-2px);
  }

  @media (max-width: 1020px) {
    .tab-list button { font-size: 20px; }
  }

  @media (max-width: 780px) {
    .tab-list {
      display: flex;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 24px;
      scrollbar-width: none;
    }

    .tab-list::-webkit-scrollbar { display: none; }
    .tab-list button { flex: 0 0 auto; font-size: 18px; }
    .tab-panel { border-radius: 28px; }
    .prose-panel, .experience-panel { padding: 26px 22px; }
    .experience-heading { display: grid; }
    .skills-panel { grid-template-columns: 1fr; }
    .skills-panel article + article { border-top: 1px dashed var(--line); border-left: 0; }
    .education-panel article { display: grid; }
  }
</style>
