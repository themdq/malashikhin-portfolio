---
import { capabilities, experience } from '@/data/site';
---

<section class="section experience-section" id="experience" aria-labelledby="experience-title">
  <div class="experience-column" data-reveal>
    <div class="section-heading">
      <span class="section-number">03</span>
      <h2 id="experience-title">Experience</h2>
    </div>
    <div class="timeline">
      <div class="timeline-rail" aria-hidden="true"></div>
      {experience.map((item) => (
        <article class="timeline-item">
          <span class="timeline-node" aria-hidden="true"></span>
          <h3>{item.role} <span>· {item.company}</span></h3>
          <p class="timeline-period">{item.period}</p>
          <p>{item.summary}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="capabilities-column" data-reveal>
    <h2>Capabilities</h2>
    <div class="capability-list">
      {capabilities.map((group) => (
        <div class="capability-row">
          <h3>{group.title}</h3>
          <p>{group.items.join(', ')}</p>
          <span aria-hidden="true">→</span>
        </div>
      ))}
    </div>
  </div>
</section>
