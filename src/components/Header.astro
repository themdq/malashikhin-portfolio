---
const nav = [
  { label: 'About', href: '#about' },
  { label: 'Work', href: '#work' },
  { label: 'Experience', href: '#experience' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="site-header glass-frame">
  <a class="brand" href="#top" aria-label="Dmitrii Malashikhin, back to top">DM</a>
  <nav aria-label="Primary navigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
    <span class="theme-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.93 4.93l1.56 1.56M17.51 17.51l1.56 1.56M19.07 4.93l-1.56 1.56M6.49 17.51l-1.56 1.56"></path>
      </svg>
    </span>
    <span class="sr-only" data-theme-label>Use light theme</span>
  </button>
</header>
