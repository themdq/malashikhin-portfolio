---
import { site } from '@/data/site';

const nav = [
  { key: 'index', label: 'Index', href: '#index' },
  { key: 'about', label: 'About', href: '#about' },
  { key: 'contacts', label: 'Contacts', href: '#contacts' },
] as const;
---

<button
  class="sidebar-toggle"
  type="button"
  aria-controls="top"
  aria-expanded="false"
  aria-label="Open navigation"
  data-sidebar-toggle
  data-liquid-glass="amber"
>[dm]</button>

<aside class="sidebar" id="top" aria-hidden="true" inert data-sidebar data-liquid-glass="amber">
  <a class="sidebar-brand" href="#index" aria-label={`${site.name}, home`}>d@malashikh.in ~</a>
  <nav class="sidebar-nav" aria-label="Primary navigation">
    {nav.map((item) => (
      <a class:list={{ 'is-active': item.key === 'index' }} href={item.href} data-section-link={item.key}>
        {item.label}
      </a>
    ))}
    <span class="nav-disabled" aria-disabled="true">/*Projects*/</span>
    <span class="nav-disabled" aria-disabled="true">/*Articles*/</span>
    <a href={site.resume} target="_blank">Resume</a>
  </nav>
  <span class="sidebar-prompt" aria-hidden="true">&gt;_</span>
</aside>

<nav class="mobile-nav" aria-label="Mobile navigation" data-liquid-glass="amber">
  <a class="mobile-brand" href="#index">d@malashikh.in ~</a>
  <div>
    {nav.map((item) => (
      <a class:list={{ 'is-active': item.key === 'index' }} href={item.href} data-section-link={item.key}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<script>
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');

  if (sidebar && toggle) {
    const setSidebarOpen = (open: boolean) => {
      document.documentElement.classList.toggle('sidebar-open', open);
      sidebar.setAttribute('aria-hidden', String(!open));
      sidebar.inert = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    toggle.addEventListener('click', () => {
      setSidebarOpen(!document.documentElement.classList.contains('sidebar-open'));
    });

    sidebar.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => setSidebarOpen(false));
    });

    addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setSidebarOpen(false);
    });

    setSidebarOpen(false);
  }
</script>

<style>
  .sidebar-toggle {
    position: fixed;
    top: 28px;
    left: var(--rail-left);
    z-index: 22;
    display: grid;
    width: 64px;
    height: 52px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 252, 240, .34);
    border-radius: 19px;
    background: linear-gradient(145deg, rgba(232, 121, 47, .95), rgba(157, 67, 16, .92));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .3), 0 12px 28px rgba(80, 30, 6, .24);
    color: var(--on-orange);
    cursor: pointer;
    backdrop-filter: blur(18px) saturate(145%);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .sidebar-toggle:hover {
    border-color: rgba(255, 252, 240, .52);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .38), 0 15px 32px rgba(80, 30, 6, .28);
    transform: translateY(-2px);
  }

  :global(.sidebar-open) .sidebar-toggle {
    display: none;
  }

  .sidebar {
    position: fixed;
    top: 28px;
    bottom: 28px;
    left: var(--rail-left);
    z-index: 20;
    display: flex;
    width: var(--rail-width);
    flex-direction: column;
    padding: 36px 32px 30px;
    border: 1px solid var(--orange);
    border-radius: 40px;
    background:
      linear-gradient(180deg, #bc5215 0%, #da702c 50.07%, #bc5215 100%),
      linear-gradient(0deg, #da702c, #da702c),
      linear-gradient(0deg, #999, #999),
      linear-gradient(0deg, #fff, #fff),
      rgba(255, 255, 255, .75);
    background-blend-mode: normal, plus-darker, overlay, saturation, normal;
    box-shadow: 0 8px 40px rgba(0, 0, 0, .12);
    color: var(--on-orange);
    opacity: 0;
    pointer-events: none;
    transform: translateX(calc(-100% - var(--rail-left) - 20px));
    transition: opacity 220ms ease, transform 320ms cubic-bezier(.22, 1, .36, 1);
  }

  :global(.sidebar-open) .sidebar {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .sidebar-brand { margin-top: 58px; white-space: nowrap; }

  .sidebar-nav {
    display: grid;
    justify-items: center;
    gap: 20px;
    margin-top: min(31vh, 320px);
  }

  .sidebar-nav a, .nav-disabled {
    width: fit-content;
    min-width: 84px;
    padding: 2px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
  }

  .sidebar-nav a {
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .sidebar-nav a.is-active {
    border-color: rgba(255, 255, 255, .16);
    background: rgba(255, 255, 255, .06);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), 0 8px 18px rgba(80, 30, 6, .2);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .sidebar-nav a:hover {
    border-color: rgba(255, 255, 255, .14);
    background: rgba(255, 255, 255, .05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .16), 0 6px 14px rgba(80, 30, 6, .18);
    transform: translateX(3px) translateY(-1px);
  }

  .nav-disabled { color: #fed3af; font-style: italic; cursor: not-allowed; }
  .sidebar-prompt { margin-top: auto; }
  .mobile-nav { display: none; }

  @media (max-width: 1020px) {
    .sidebar { padding-right: 28px; padding-left: 28px; }
  }

  @media (max-width: 780px) {
    .sidebar, .sidebar-toggle { display: none; }

    .mobile-nav {
      position: fixed;
      top: 14px;
      right: 74px;
      left: 14px;
      z-index: 20;
      display: flex;
      min-height: 54px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 14px;
      border: 1px solid rgba(255, 252, 240, .28);
      border-radius: 20px;
      background: linear-gradient(180deg, rgba(218, 112, 44, .94), rgba(188, 82, 21, .92));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .26), 0 12px 24px var(--shadow);
      color: var(--on-orange);
      backdrop-filter: blur(18px) saturate(135%);
    }

    .mobile-brand { font-size: 12px; }
    .mobile-nav div { display: flex; gap: 6px; }

    .mobile-nav div a {
      padding: 4px 7px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 11px;
      transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .mobile-nav div a:hover, .mobile-nav div a.is-active {
      border-color: rgba(255, 255, 255, .16);
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), 0 5px 12px rgba(80, 30, 6, .18);
      transform: translateY(-1px);
    }
  }

  @media (max-width: 600px) {
    .mobile-nav { justify-content: center; }
    .mobile-brand { display: none; }
    .mobile-nav div { width: 100%; justify-content: space-around; }
    .mobile-nav div a { padding-right: 9px; padding-left: 9px; }
  }
</style>
