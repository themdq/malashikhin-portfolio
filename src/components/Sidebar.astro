---
import { site } from '@/data/site';

const nav = [
  { key: 'index', label: 'Index', href: '#index' },
  { key: 'about', label: 'About', href: '#about' },
  { key: 'contacts', label: 'Contacts', href: '#contacts' },
] as const;
---

<aside class="sidebar" id="top" data-liquid-glass="amber">
  <a class="sidebar-brand" href="#index" aria-label={`${site.name}, home`}>d@malashikh.in ~</a>
  <nav class="sidebar-nav" aria-label="Primary navigation">
    {nav.map((item) => (
      <a class:list={{ 'is-active': item.key === 'index' }} href={item.href} data-section-link={item.key}>
        {item.label}
      </a>
    ))}
    <span class="nav-disabled" aria-disabled="true">/*Projects*/</span>
    <span class="nav-disabled" aria-disabled="true">/*Articles*/</span>
    <a href={site.resume} target="_blank">Resume</a>
  </nav>
  <span class="sidebar-prompt" aria-hidden="true">&gt;_</span>
</aside>

<nav class="mobile-nav" aria-label="Mobile navigation" data-liquid-glass="amber">
  <a class="mobile-brand" href="#index">d@malashikh.in ~</a>
  <div>
    {nav.map((item) => (
      <a class:list={{ 'is-active': item.key === 'index' }} href={item.href} data-section-link={item.key}>
        {item.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    top: 28px;
    bottom: 28px;
    left: var(--rail-left);
    z-index: 20;
    display: flex;
    width: var(--rail-width);
    flex-direction: column;
    padding: 36px 32px 30px;
    border: 1px solid var(--orange);
    border-radius: 40px;
    background:
      linear-gradient(180deg, #bc5215 0%, #da702c 50.07%, #bc5215 100%),
      linear-gradient(0deg, #da702c, #da702c),
      linear-gradient(0deg, #999, #999),
      linear-gradient(0deg, #fff, #fff),
      rgba(255, 255, 255, .75);
    background-blend-mode: normal, plus-darker, overlay, saturation, normal;
    box-shadow: 0 8px 40px rgba(0, 0, 0, .12);
    color: var(--on-orange);
  }

  .sidebar-brand { white-space: nowrap; }

  .sidebar-nav {
    display: grid;
    gap: 20px;
    margin-top: min(31vh, 320px);
    padding-left: 25px;
  }

  .sidebar-nav a, .nav-disabled {
    width: fit-content;
    min-width: 84px;
    padding: 2px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
  }

  .sidebar-nav a {
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .sidebar-nav a.is-active {
    border-color: rgba(255, 255, 255, .16);
    background: rgba(255, 255, 255, .06);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), 0 8px 18px rgba(80, 30, 6, .2);
    backdrop-filter: blur(16px) saturate(140%);
  }

  .sidebar-nav a:hover {
    border-color: rgba(255, 255, 255, .14);
    background: rgba(255, 255, 255, .05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .16), 0 6px 14px rgba(80, 30, 6, .18);
    transform: translateX(3px) translateY(-1px);
  }

  .nav-disabled { color: #fed3af; font-style: italic; cursor: not-allowed; }
  .sidebar-prompt { margin-top: auto; }
  .mobile-nav { display: none; }

  @media (max-width: 1020px) {
    .sidebar { padding-right: 28px; padding-left: 28px; }
  }

  @media (max-width: 780px) {
    .sidebar { display: none; }

    .mobile-nav {
      position: fixed;
      top: 14px;
      right: 74px;
      left: 14px;
      z-index: 20;
      display: flex;
      min-height: 54px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 14px;
      border: 1px solid rgba(255, 252, 240, .28);
      border-radius: 20px;
      background: linear-gradient(180deg, rgba(218, 112, 44, .94), rgba(188, 82, 21, .92));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .26), 0 12px 24px var(--shadow);
      color: var(--on-orange);
      backdrop-filter: blur(18px) saturate(135%);
    }

    .mobile-brand { font-size: 12px; }
    .mobile-nav div { display: flex; gap: 6px; }

    .mobile-nav div a {
      padding: 4px 7px;
      border: 1px solid transparent;
      border-radius: 999px;
      font-size: 11px;
      transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .mobile-nav div a:hover, .mobile-nav div a.is-active {
      border-color: rgba(255, 255, 255, .16);
      background: rgba(255, 255, 255, .06);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), 0 5px 12px rgba(80, 30, 6, .18);
      transform: translateY(-1px);
    }
  }

  @media (max-width: 600px) {
    .mobile-nav { justify-content: center; }
    .mobile-brand { display: none; }
    .mobile-nav div { width: 100%; justify-content: space-around; }
    .mobile-nav div a { padding-right: 9px; padding-left: 9px; }
  }
</style>
