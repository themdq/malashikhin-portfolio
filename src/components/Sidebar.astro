---
import { site } from '@/data/site';

const nav = [
  { key: 'index', label: 'Index', href: '#index' },
  { key: 'work', label: 'Work', href: '#work' },
  { key: 'about', label: 'About', href: '#about' },
  { key: 'contacts', label: 'Contact', href: '#contacts' },
] as const;
---

<header class="site-header" id="top">
  <a class="identity" href="#index" aria-label={`${site.name}, home`}>
    <span>&gt;_</span>
    <strong>Dmitrii Malashikhin</strong>
    <small>/ Data Engineer</small>
  </a>

  <nav class="site-nav" aria-label="Primary navigation" data-section-nav>
    {nav.map((item) => (
      <a class:list={{ 'is-active': item.key === 'index' }} href={item.href} data-section-link={item.key}>
        {item.label}
      </a>
    ))}
    <a class="mobile-resume-link" href={site.resume} target="_blank">CV ↗</a>
  </nav>

  <div class="header-meta">
    <span class="availability">New York / EDT</span>
    <a class="resume-link" href={site.resume} target="_blank">Resume ↗</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: minmax(260px, 1fr) auto minmax(260px, 1fr);
    align-items: center;
    gap: 24px;
    padding: 10px 94px 10px var(--gutter);
    border-bottom: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--page) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .identity {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 9px;
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .identity span { color: var(--orange); font-size: 16px; }
  .identity strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .identity small { color: var(--muted); font: inherit; white-space: nowrap; }

  .site-nav { display: flex; align-items: center; gap: 2px; }
  .mobile-resume-link { display: none !important; }

  .site-nav a, .resume-link {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid transparent;
    border-radius: 4px;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .site-nav a:hover, .site-nav a.is-active, .resume-link:hover {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--page);
  }

  .site-nav a.is-active::before { content: '['; color: var(--orange); }
  .site-nav a.is-active::after { content: ']'; color: var(--orange); }

  .header-meta {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .availability::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
    content: '';
  }

  @media (max-width: 1080px) {
    .site-header { grid-template-columns: minmax(220px, 1fr) auto; }
    .header-meta { display: none; }
  }

  @media (max-width: 780px) {
    .site-header {
      position: sticky;
      grid-template-columns: 1fr;
      align-content: center;
      gap: 10px;
      padding: 12px 66px 10px var(--gutter);
    }

    .identity { min-height: 28px; padding-right: 8px; }
    .identity small { display: none; }
    .site-nav {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 4px;
    }
    .site-nav a, .mobile-resume-link {
      display: inline-flex !important;
      min-width: 0;
      min-height: 36px;
      justify-content: center;
      padding: 4px 2px;
      font-size: 10px;
      white-space: nowrap;
    }
  }

  @media (max-width: 420px) {
    .site-header { padding-right: 62px; }
    .identity strong { max-width: calc(100vw - 118px); }
  }
</style>
