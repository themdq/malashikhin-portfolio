<div class="theme-control">
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
    <span aria-hidden="true">◐</span>
    <span class="sr-only" data-theme-label>Use dark theme</span>
  </button>
</div>

<style>
  .theme-control {
    position: fixed;
    top: 21px;
    right: 24px;
    z-index: 1100;
  }

  .theme-toggle {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--page);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .theme-toggle:hover {
    background: var(--blue);
    color: #fffcf0;
    transform: translateY(-2px);
  }

  .theme-toggle span[aria-hidden] { font-size: 21px; line-height: 1; }

  @media (max-width: 780px) {
    .theme-control { top: 18px; right: 18px; }
  }
</style>
