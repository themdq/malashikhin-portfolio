---
import AboutTabs from '@/components/AboutTabs.astro';
import PageShell from '@/components/PageShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects, site } from '@/data/site';

const tickerItems = ['Online', 'Python', 'SQL', 'Airflow', 'Kubernetes', 'New York / EDT', 'Reliability > hype'];
const socials = [
  { label: 'Email', href: `mailto:${site.email}` },
  ...site.social,
];
---

<BaseLayout>
  <PageShell>
    <main id="main">
      <section class="hero page-section" id="index" data-page-section="index">
        <div class="hero-name">
          <p class="eyebrow"><span>[01]</span> Data Engineer / New York</p>
          <h1><span>Dmitrii</span><em>Malashikhin</em></h1>
        </div>

        <div class="hero-copy">
          <p class="hero-index">R1 / 40.7128° N<br />74.0060° W</p>
          <h2>Reliable systems for an <em>unreliable world.</em></h2>
          <p>{site.description}</p>
          <a class="text-link" href="#work">View selected work <span aria-hidden="true">↓</span></a>
          <ul class="hero-proof" aria-label="Professional summary">
            <li><strong>03+</strong><span>Years in data</span></li>
            <li><strong>02</strong><span>Production roles</span></li>
            <li><strong>NYC</strong><span>Based / EDT</span></li>
          </ul>
        </div>
      </section>

      <div class="status-ticker" aria-label="Core capabilities">
        <div class="ticker-track">
          {[...tickerItems, ...tickerItems].map((item, index) => (
            <span class:list={{ 'is-status': item === 'Online', 'is-location': item.includes('New York') }} aria-hidden={index >= tickerItems.length ? 'true' : undefined}>
              {item === 'Online' && <i aria-hidden="true"></i>}{item}
            </span>
          ))}
        </div>
      </div>

      <section class="work-section page-section" id="work" data-page-section="work">
        <header class="section-rail work-rail">
          <div>
            <span class="section-number">[02]</span>
            <h2>Selected<br />work</h2>
          </div>
          <p>[03 case files]<br />shipped for utility</p>
        </header>

        <div class="project-list">
          {projects.map((project, index) => (
            <a
              class="project-row"
              href={project.demo ?? project.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`Open ${project.title} ${project.demo ? 'live site' : 'source code'} in a new tab`}
            >
              <span class="project-number">{String(index + 1).padStart(2, '0')}:</span>
              <span class="project-title-wrap">
                <span class="project-title">{project.title}</span>
                <span class="project-kind">{project.demo ? 'Live system' : 'Open source'}</span>
              </span>
              <span class="project-meta">
                <span>{project.description}</span>
                <span class="project-stack">
                  {project.technologies.map((technology) => <b>{technology}</b>)}
                </span>
              </span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="about-section page-section" id="about" data-page-section="about">
        <header class="about-heading">
          <div>
            <span class="section-number">[03]</span>
            <h2>Systems thinking,<br /><em>human scale.</em></h2>
          </div>
          <div class="about-note">
            <span>Working principle / 01</span>
            <p>{site.philosophy}</p>
          </div>
        </header>
        <AboutTabs />
      </section>

      <section class="contacts-section page-section" id="contacts" data-page-section="contacts">
        <div class="contact-label">
          <span class="section-number">[04]</span>
          <p>Have a system to untangle<br />or a pipeline to build?</p>
        </div>

        <div class="contact-main">
          <p class="contact-kicker">Start a conversation</p>
          <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="contact-note">For data platforms, pipeline reliability, and engineering work that needs a clear path from source to production.</p>
          <nav class="social-links" aria-label="Contact links">
            {socials.map((item, index) => (
              <a href={item.href} target={item.label === 'Email' ? undefined : '_blank'} rel={item.label === 'Email' ? undefined : 'noreferrer'}>
                <span>{String(index + 1).padStart(2, '0')}</span>{item.label}<b aria-hidden="true">↗</b>
              </a>
            ))}
          </nav>
        </div>

        <footer class="page-footer">
          <span>d@malashikh.in ~</span>
          <span>© {new Date().getFullYear()} / built with Astro / <a href="#index">Back to top ↑</a></span>
        </footer>
      </section>
    </main>
  </PageShell>
</BaseLayout>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-page-section]'));
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const scrollProgress = document.querySelector<HTMLElement>('[data-scroll-progress]');

  const setActiveSection = (id: string) => {
    sectionLinks.forEach((link) => {
      const active = link.dataset.sectionLink === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const scrollToSection = (id: string, behavior: ScrollBehavior = 'smooth') => {
    const section = document.querySelector<HTMLElement>(`[data-page-section="${id}"]`);
    if (!section) return;
    section.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : behavior, block: 'start' });
    setActiveSection(id);
  };

  let sectionUpdateFrame = 0;
  const updateActiveSection = () => {
    sectionUpdateFrame = 0;
    const activeLine = innerHeight * .32;
    const activeSection = sections.reduce((active, section) => section.getBoundingClientRect().top <= activeLine ? section : active, sections[0]);
    const id = activeSection?.dataset.pageSection;
    if (id) setActiveSection(id);
    const scrollable = document.documentElement.scrollHeight - innerHeight;
    const progress = scrollable > 0 ? Math.min(scrollY / scrollable, 1) : 0;
    if (scrollProgress) scrollProgress.style.transform = `scaleX(${progress})`;
  };

  const scheduleSectionUpdate = () => {
    if (!sectionUpdateFrame) sectionUpdateFrame = requestAnimationFrame(updateActiveSection);
  };

  sectionLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.dataset.sectionLink;
      if (!id) return;
      event.preventDefault();
      history.pushState(null, '', `#${id}`);
      scrollToSection(id);
    });
  });

  addEventListener('scroll', scheduleSectionUpdate, { passive: true });
  addEventListener('resize', scheduleSectionUpdate);
  addEventListener('popstate', () => scrollToSection(location.hash.slice(1) || 'index', 'auto'));
  scheduleSectionUpdate();
</script>

<style>
  .page-section { scroll-margin-top: var(--header-height); }

  .hero {
    position: relative;
    display: grid;
    min-height: clamp(560px, calc(100svh - 170px), 760px);
    grid-template-columns: minmax(0, 1.55fr) minmax(340px, .75fr);
    gap: clamp(36px, 6vw, 100px);
    align-items: center;
    padding: 38px var(--gutter) 42px;
    overflow: hidden;
    border-bottom: 1px solid var(--line-strong);
    background:
      linear-gradient(90deg, transparent 49.9%, color-mix(in srgb, var(--line) 38%, transparent) 50%, transparent 50.1%),
      radial-gradient(circle at 78% 18%, color-mix(in srgb, var(--blue) 11%, transparent), transparent 30%);
  }

  .hero::before {
    position: absolute;
    right: var(--gutter);
    bottom: 20px;
    color: color-mix(in srgb, var(--muted) 70%, transparent);
    content: 'ETL // OBSERVE // VALIDATE // SHIP';
    font-size: 9px;
    letter-spacing: .08em;
    writing-mode: vertical-rl;
  }

  .hero-name, .hero-copy { position: relative; z-index: 1; min-width: 0; }
  .hero-name { animation: hero-enter 650ms cubic-bezier(.2, .7, .2, 1) both; }
  .hero-copy { animation: hero-enter 650ms 100ms cubic-bezier(.2, .7, .2, 1) both; }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(18px); }
  }

  .eyebrow, .section-number, .hero-index, .contact-kicker {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
    color: var(--orange-deep);
  }

  .eyebrow span { color: var(--blue); }
  .eyebrow::after { width: 78px; height: 1px; background: var(--orange); content: ''; }

  .hero h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--fs-display);
    font-weight: 400;
    line-height: .72;
  }

  .hero h1 span, .hero h1 em { display: block; }
  .hero h1 em { margin-left: clamp(32px, 7vw, 120px); color: var(--orange); font-weight: 400; }

  .hero-copy { display: grid; align-self: stretch; align-content: center; padding-top: 24px; }

  .hero-index {
    justify-self: end;
    margin: 0 0 auto;
    color: var(--blue);
    line-height: 1.5;
    text-align: right;
  }

  .hero-copy h2 {
    max-width: 510px;
    margin: 26px 0 22px;
    font-family: var(--serif);
    font-size: clamp(38px, 3.3vw, 58px);
    font-weight: 400;
    line-height: .95;
  }

  .hero-copy h2 em { color: var(--blue); font-weight: 400; }
  .hero-copy > p:not(.hero-index) { max-width: 470px; margin: 0; color: var(--ink-soft); font-family: system-ui, sans-serif; font-size: 16px; }

  .text-link {
    width: fit-content;
    margin-top: 30px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--orange);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
  }

  .text-link span { color: var(--orange); }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 520px;
    margin: clamp(34px, 6vh, 64px) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    list-style: none;
  }

  .hero-proof li {
    display: grid;
    min-width: 0;
    gap: 2px;
    padding: 14px 12px;
    border-right: 1px solid var(--line);
  }

  .hero-proof li:first-child { padding-left: 0; }
  .hero-proof li:last-child { border-right: 0; }
  .hero-proof strong { color: var(--orange); font-size: 16px; font-weight: 600; }
  .hero-proof span { color: var(--muted); font-size: 9px; text-transform: uppercase; }

  .status-ticker {
    display: flex;
    height: 42px;
    align-items: center;
    overflow: hidden;
    background: var(--ink);
    color: var(--page);
    white-space: nowrap;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 34px;
    animation: ticker-crawl 28s linear infinite;
  }

  .ticker-track span { display: inline-flex; align-items: center; gap: 9px; font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; }
  .ticker-track span::after { color: var(--muted); content: '///'; margin-left: 24px; }
  .ticker-track .is-status { color: var(--orange); }
  .ticker-track .is-status i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .ticker-track .is-location { color: var(--blue); }

  @keyframes ticker-crawl { to { transform: translateX(-50%); } }

  .work-section { display: grid; grid-template-columns: minmax(240px, .32fr) minmax(0, 1fr); border-bottom: 1px solid var(--line-strong); }

  .section-rail {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px var(--gutter);
    border-right: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .section-number { color: var(--orange); }
  .section-rail h2 { margin: 18px 0 0; font-family: var(--serif); font-size: clamp(44px, 4.2vw, 68px); font-weight: 400; line-height: .82; }
  .section-rail p { margin: 54px 0 0; color: var(--muted); font-size: var(--fs-xs); text-transform: uppercase; }

  .project-row {
    display: grid;
    min-height: 134px;
    grid-template-columns: 62px minmax(230px, 1fr) minmax(260px, 1fr) 46px;
    gap: 24px;
    align-items: center;
    padding: 20px var(--gutter);
    border-bottom: 1px solid var(--line);
    transition: background-color 180ms ease, color 180ms ease;
  }

  .project-row:last-child { border-bottom: 0; }
  .project-row:hover, .project-row:focus-visible { outline: 0; background: var(--orange); color: var(--on-orange); }
  .project-number { color: var(--blue); font-size: var(--fs-sm); font-weight: 600; }
  .project-title-wrap { display: grid; min-width: 0; gap: 8px; }
  .project-title { font-family: var(--serif); font-size: clamp(32px, 3.4vw, 54px); line-height: .95; }
  .project-kind { width: fit-content; color: var(--orange-deep); font-size: 9px; letter-spacing: .04em; text-transform: uppercase; }
  .project-kind::before { content: '[ '; }
  .project-kind::after { content: ' ]'; }
  .project-meta { display: grid; gap: 14px; color: var(--muted); font-size: var(--fs-xs); text-transform: uppercase; }
  .project-stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .project-stack b {
    padding: 4px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 9px;
    font-weight: 400;
  }
  .project-row:hover .project-number, .project-row:focus-visible .project-number { color: #fffcf0; }
  .project-row:hover .project-meta, .project-row:hover .project-meta b,
  .project-row:focus-visible .project-meta, .project-row:focus-visible .project-meta b { color: var(--on-orange); }
  .project-row:hover .project-stack b, .project-row:focus-visible .project-stack b { border-color: color-mix(in srgb, var(--on-orange) 55%, transparent); }
  .project-row:hover .project-kind, .project-row:focus-visible .project-kind { color: var(--on-orange); }

  .project-arrow {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-size: 20px;
    transition: transform 180ms ease;
  }

  .project-row:hover .project-arrow, .project-row:focus-visible .project-arrow { transform: translate(3px, -3px); }

  .about-section { padding-top: 96px; border-bottom: 1px solid var(--line-strong); }

  .about-heading {
    display: grid;
    grid-template-columns: minmax(360px, 1.2fr) minmax(280px, .8fr);
    gap: 60px;
    align-items: end;
    padding: 0 var(--gutter) 72px;
  }

  .about-heading h2 { margin: 20px 0 0; font-family: var(--serif); font-size: clamp(58px, 7vw, 104px); font-weight: 400; line-height: .84; }
  .about-heading h2 em { color: var(--blue); font-weight: 400; }
  .about-note { max-width: 510px; justify-self: end; }
  .about-note span { display: block; margin-bottom: 14px; color: var(--orange-deep); font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; }
  .about-note p { margin: 0; color: var(--ink-soft); font-family: var(--serif); font-size: clamp(24px, 2.3vw, 36px); line-height: 1.06; }

  .contacts-section { display: grid; grid-template-columns: minmax(250px, .32fr) minmax(0, 1fr); background: var(--orange); color: var(--on-orange); }
  .contact-label { padding: 44px var(--gutter); border-right: 1px solid currentColor; }
  .contact-label .section-number { color: var(--on-orange); }
  .contact-label p { margin: 36px 0 0; font-size: var(--fs-xs); text-transform: uppercase; }
  .contact-main { min-width: 0; padding: 54px var(--gutter) 70px; }
  .contact-kicker { margin: 0 0 18px; }

  .contact-email {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 112px);
    line-height: .9;
  }

  .contact-email:hover { color: var(--ink); }

  .contact-note {
    max-width: 640px;
    margin: 30px 0 0;
    font-size: var(--fs-sm);
    line-height: 1.65;
  }

  .social-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 64px;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  .social-links a { display: grid; min-height: 76px; grid-template-columns: 34px 1fr auto; align-items: center; gap: 8px; padding: 14px 16px; border-right: 1px solid currentColor; font-size: var(--fs-xs); text-transform: uppercase; }
  .social-links a:last-child { border-right: 0; }
  .social-links a:hover { background: var(--ink); color: var(--page); }
  .social-links a span { opacity: .72; }
  .social-links a b { font-size: 18px; font-weight: 400; }

  .page-footer { display: flex; grid-column: 1 / -1; justify-content: space-between; gap: 20px; padding: 16px var(--gutter); border-top: 1px solid currentColor; font-size: var(--fs-xs); text-transform: uppercase; }
  .page-footer a { border-bottom: 1px solid currentColor; }

  @media (max-width: 1050px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .hero-name { align-self: end; }
    .hero-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 42px; align-self: start; padding-top: 0; }
    .hero-index { grid-column: 2; grid-row: 1 / span 2; }
    .hero-copy h2 { margin: 0; }
    .hero-copy > p:not(.hero-index) { grid-column: 1; }
    .text-link { grid-column: 2; grid-row: 3; justify-self: end; align-self: end; }
    .hero-proof { max-width: none; grid-column: 1 / -1; }
    .work-section { grid-template-columns: 220px minmax(0, 1fr); }
    .project-row { grid-template-columns: 50px minmax(190px, 1fr) 46px; }
    .project-meta { grid-column: 2; }
    .project-arrow { grid-column: 3; grid-row: 1 / span 2; }
    .social-links { grid-template-columns: repeat(2, 1fr); }
    .social-links a:nth-child(2) { border-right: 0; }
    .social-links a:nth-child(-n + 2) { border-bottom: 1px solid currentColor; }
  }

  @media (max-width: 760px) {
    .page-section { scroll-margin-top: var(--header-height); }
    .hero {
      min-height: calc(100svh - var(--header-height) - 38px);
      gap: 40px;
      padding-top: 42px;
      padding-bottom: 54px;
      background: radial-gradient(circle at 90% 8%, color-mix(in srgb, var(--blue) 10%, transparent), transparent 34%);
    }
    .hero::before { display: none; }
    .eyebrow { gap: 10px; margin-bottom: 22px; font-size: 10px; white-space: nowrap; }
    .eyebrow::after { width: clamp(28px, 12vw, 48px); }
    .hero h1 { max-width: 100%; font-size: clamp(44px, 14.4vw, 64px); line-height: .82; letter-spacing: -.025em; }
    .hero h1 em { margin-left: clamp(12px, 4.5vw, 22px); }
    .hero-copy { grid-template-columns: 1fr; gap: 24px; }
    .hero-index { grid-column: 1; grid-row: auto; justify-self: start; text-align: left; }
    .hero-copy h2 { max-width: 100%; margin: 0; font-size: clamp(38px, 11.5vw, 50px); line-height: .96; }
    .hero-copy > p:not(.hero-index) { font-size: 15px; line-height: 1.6; }
    .text-link { grid-column: 1; grid-row: auto; justify-self: start; margin-top: 8px; }
    .hero-proof { grid-column: 1; margin-top: 12px; }
    .hero-proof li { padding: 12px 8px; }
    .hero-proof li:first-child { padding-left: 0; }
    .hero-proof strong { font-size: 14px; }
    .status-ticker { height: 38px; }
    .work-section { grid-template-columns: 1fr; }
    .section-rail { min-height: 170px; flex-direction: row; align-items: end; border-right: 0; border-bottom: 1px solid var(--line-strong); }
    .section-rail p { margin: 0; text-align: right; }
    .section-rail h2 { font-size: clamp(42px, 13vw, 56px); }
    .project-row { min-height: 0; grid-template-columns: 30px minmax(0, 1fr) 38px; gap: 12px; padding: 24px var(--gutter); }
    .project-title { font-size: clamp(28px, 8.5vw, 38px); line-height: 1; }
    .project-kind { font-size: 8px; }
    .project-meta { grid-column: 2 / -1; line-height: 1.55; }
    .project-arrow { width: 36px; height: 36px; grid-column: 3; grid-row: 1; }
    .about-section { padding-top: 68px; }
    .about-heading { grid-template-columns: 1fr; gap: 28px; padding-bottom: 44px; }
    .about-heading h2 { font-size: clamp(38px, 11.5vw, 52px); line-height: .9; }
    .about-note { justify-self: start; }
    .contacts-section { grid-template-columns: 1fr; }
    .contact-label { display: flex; justify-content: space-between; gap: 20px; padding-top: 30px; padding-bottom: 30px; border-right: 0; border-bottom: 1px solid currentColor; }
    .contact-label p { margin: 0; text-align: right; }
    .contact-main { padding-top: 40px; padding-bottom: 48px; }
    .contact-email { font-size: clamp(30px, 9.4vw, 42px); white-space: nowrap; }
    .social-links { grid-template-columns: repeat(2, 1fr); margin-top: 44px; }
    .social-links a { min-height: 64px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; }
    .social-links a:nth-child(2n) { border-right: 0; }
    .social-links a:nth-last-child(-n + 2) { border-bottom: 0; }
    .page-footer { flex-direction: column; }
  }

  @media (max-width: 350px) {
    .hero { gap: 40px; padding-top: 36px; }
    .hero h1 { font-size: clamp(42px, 14vw, 49px); }
    .hero-copy h2 { font-size: 37px; }
    .hero-proof span { font-size: 8px; }
    .contact-email { font-size: 28px; }
    .social-links { grid-template-columns: 1fr; }
    .social-links a { border-right: 0; }
    .social-links a:nth-last-child(-n + 2) { border-bottom: 1px solid currentColor; }
    .social-links a:last-child { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { width: 100%; justify-content: space-around; animation: none; }
    .ticker-track span[aria-hidden='true'] { display: none; }
  }
</style>
