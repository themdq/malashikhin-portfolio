              {item.icon === 'linkedin' && <svg viewBox="0 0 55 55" aria-hidden="true" class="filled-icon"><path d="M48.8889 0C50.5097 0 52.064 0.643847 53.2101 1.7899C54.3562 2.93596 55 4.49034 55 6.11111V48.8889C55 50.5097 54.3562 52.064 53.2101 53.2101C52.064 54.3562 50.5097 55 48.8889 55H6.11111C4.49034 55 2.93596 54.3562 1.7899 53.2101C0.643847 52.064 0 50.5097 0 48.8889V6.11111C0 4.49034 0.643847 2.93596 1.7899 1.7899C2.93596 0.643847 4.49034 0 6.11111 0H48.8889ZM47.3611 47.3611V31.1667C47.3611 28.5248 46.3116 25.9912 44.4436 24.1231C42.5755 22.255 40.0419 21.2056 37.4 21.2056C34.8028 21.2056 31.7778 22.7944 30.3111 25.1778V21.7861H21.7861V47.3611H30.3111V32.2972C30.3111 29.9444 32.2056 28.0194 34.5583 28.0194C35.6929 28.0194 36.7809 28.4701 37.5832 29.2724C38.3854 30.0746 38.8361 31.1627 38.8361 32.2972V47.3611H47.3611ZM11.8556 16.9889C13.217 16.9889 14.5227 16.4481 15.4854 15.4854C16.4481 14.5227 16.9889 13.217 16.9889 11.8556C16.9889 9.01389 14.6972 6.69167 11.8556 6.69167C10.486 6.69167 9.17255 7.23572 8.20413 8.20413C7.23572 9.17255 6.69167 10.486 6.69167 11.8556C6.69167 14.6972 9.01389 16.9889 11.8556 16.9889ZM16.1028 47.3611V21.7861H7.63889V47.3611H16.1028Z"></path></svg>}
              {item.icon === 'github' && <svg viewBox="0 0 55 55" aria-hidden="true" class="filled-icon"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C7.34784 0 4.8043 1.05357 2.92893 2.92893C1.05357 4.8043 0 7.34784 0 10V45C0 47.6522 1.05357 50.1957 2.92893 52.0711C4.8043 53.9464 7.34784 55 10 55H45C47.6522 55 50.1957 53.9464 52.0711 52.0711C53.9464 50.1957 55 47.6522 55 45V10C55 7.34784 53.9464 4.8043 52.0711 2.92893C50.1957 1.05357 47.6522 0 45 0H10ZM14.5375 12.775C18.1546 9.70228 22.7465 8.01598 27.4925 8.0175C32.2392 8.0113 36.833 9.69565 40.4506 12.7687C44.0683 15.8418 46.4733 20.1027 47.2348 24.7879C47.9964 29.4731 47.0645 34.2764 44.6064 38.337C42.1482 42.3976 38.3243 45.4501 33.82 46.9475C32.8075 47.14 32.4825 46.55 32.4825 46.0175V40.4875C32.5307 39.8119 32.4338 39.1337 32.1984 38.4986C31.963 37.8634 31.5944 37.286 31.1175 36.805C35.5675 36.3125 40.2375 34.6275 40.2375 26.95C40.2651 24.9644 39.5295 23.044 38.1825 21.585C38.7912 19.8621 38.7197 17.9719 37.9825 16.3C37.9825 16.3 36.3175 15.765 32.4975 18.35C29.223 17.4513 25.7669 17.4513 22.4925 18.35C18.68 15.765 17 16.3 17 16.3C16.2644 17.9726 16.1947 19.8628 16.805 21.585C15.4583 23.0424 14.7218 24.9608 14.7475 26.945C14.7475 34.6025 19.4125 36.315 23.8475 36.82C23.1199 37.5274 22.6694 38.4718 22.5775 39.4825C22.0876 39.7584 21.5479 39.9344 20.9895 40.0003C20.4312 40.0661 19.8653 40.0205 19.3246 39.8661C18.784 39.7117 18.2794 39.4516 17.84 39.1008C17.4007 38.75 17.0353 38.3155 16.765 37.8225C16.4451 37.2694 16.0031 36.7965 15.4729 36.44C14.9426 36.0834 14.338 35.8526 13.705 35.765C13.705 35.765 11.755 35.74 13.57 36.9825C14.635 37.66 15.42 38.6975 15.7875 39.9025C15.7875 39.9025 16.935 43.74 22.4925 42.535C22.5 43.795 22.4975 44.8575 22.4925 45.51V46.01C22.4925 46.535 22.1775 47.1225 21.18 46.9475C17.8177 45.8304 14.813 43.839 12.4741 41.1777C10.1352 38.5163 8.54624 35.2808 7.87019 31.8028C7.19414 28.3249 7.45533 24.7297 8.62696 21.386C9.79859 18.0423 11.8385 15.0703 14.5375 12.775Z"></path></svg>}
              {item.icon === 'telegram' && <svg viewBox="0 0 55 55" aria-hidden="true" class="filled-icon"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 0C7.34784 0 4.8043 1.05357 2.92893 2.92893C1.05357 4.8043 0 7.34784 0 10V45C0 47.6522 1.05357 50.1957 2.92893 52.0711C4.8043 53.9464 7.34784 55 10 55H45C47.6522 55 50.1957 53.9464 52.0711 52.0711C53.9464 50.1957 55 47.6522 55 45V10C55 7.34784 53.9464 4.8043 52.0711 2.92893C50.1957 1.05357 47.6522 0 45 0H10ZM47.5 27.5C47.5 32.8043 45.3929 37.8914 41.6421 41.6421C37.8914 45.3929 32.8043 47.5 27.5 47.5C22.1957 47.5 17.1086 45.3929 13.3579 41.6421C9.60714 37.8914 7.5 32.8043 7.5 27.5C7.5 22.1957 9.60714 17.1086 13.3579 13.3579C17.1086 9.60714 22.1957 7.5 27.5 7.5C32.8043 7.5 37.8914 9.60714 41.6421 13.3579C45.3929 17.1086 47.5 22.1957 47.5 27.5ZM13.83 26.91C13.83 26.725 13.9525 26.5475 14.125 26.485L36.5325 17.9425C36.6103 17.9153 36.6939 17.9088 36.775 17.9238C36.8561 17.9387 36.9319 17.9744 36.995 18.0275C37.12 18.135 37.175 18.3125 37.1375 18.475L32.6675 37.27C32.6507 37.3433 32.6158 37.4112 32.5661 37.4675C32.5163 37.5239 32.4532 37.5668 32.3825 37.5925C32.3125 37.619 32.2369 37.6277 32.1627 37.6176C32.0885 37.6076 32.018 37.5792 31.9575 37.535L23.52 30.74L31.05 23.985C31.0982 23.9406 31.129 23.8804 31.1368 23.8153C31.1446 23.7503 31.1289 23.6845 31.0925 23.63C31.055 23.5759 30.9992 23.537 30.9355 23.5205C30.8717 23.504 30.8041 23.5109 30.745 23.54L19.5575 29.3175L14.125 27.335C14.04 27.3002 13.9669 27.2416 13.9146 27.1662C13.8622 27.0908 13.8328 27.0018 13.83 26.91Z"></path></svg>}
            </a>
          ))}
        </nav>

        <footer class="contact-footer"><span>/*\ ---------------------</span><a href={`mailto:${site.email}`}>{site.domain}</a><span>--------------------- /*\</span></footer>
      </section>
    </main>
  </PageShell>
</BaseLayout>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-page-section]'));

  const setActiveSection = (id: string) => {
    sectionLinks.forEach((link) => {
      const active = link.dataset.sectionLink === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      const id = (visible?.target as HTMLElement | undefined)?.dataset.pageSection;
      if (id) setActiveSection(id);
    },
    { rootMargin: '-25% 0px -55%', threshold: [0, 0.2, 0.5] },
  );

  sections.forEach((section) => observer.observe(section));
  sectionLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const id = link.dataset.sectionLink;
      if (id) setActiveSection(id);
    });
  });
</script>

<style>
  .single-page {
    width: calc(100% - 2 * (var(--rail-left) + var(--rail-width)));
    margin-inline: auto;
  }

  .page-section { min-height: 100vh; scroll-margin-top: 0; }

  .index-screen {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    padding: 80px 7vw;
  }

  .index-screen h1, .about-header h2, .contacts-header h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(76px, 5.35vw, 106px);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: .95;
  }

  .index-screen p { margin: 35px 0 0; color: var(--muted); font-size: 20px; white-space: nowrap; }
  :global(:root[data-theme='dark']) .index-screen p { color: var(--muted); }
  .index-screen p span { margin-right: 14px; }
  .about-screen { padding: 92px clamp(48px, 8vw, 150px) 56px; }
  .about-header { text-align: center; }
  .about-header h2 { font-size: clamp(76px, 6.2vw, 120px); }
  .about-header > p { margin: -5px 0 48px; font-size: clamp(24px, 2.15vw, 42px); }

  .rule-title {
    display: flex;
    /* width: min(690px, 85%); */
    align-items: center;
    gap: 14px;
    /* margin: 13px auto 0; */  
    color: var(--muted);
  }

  .rule-title span { font-size: 19px; font-style: normal; }
  .rule-title .rule-line { flex: 1; overflow: hidden; color: var(--line); letter-spacing: .08em; white-space: nowrap; }
  .contacts-screen { display: grid; grid-template-rows: 1fr auto 72px; padding: 125px 48px 28px; }
  .contacts-header { width: min(620px, 100%); justify-self: center; text-align: center; }
  .contacts-header h2 { font-size: clamp(76px, 5.8vw, 112px); }
  .contacts-header p { max-width: 520px; margin: 8px auto 0; font-size: 17px; line-height: 1.35; }
  .contacts-header .rule-title { width: 100%; }

  .social-dock {
    display: flex;
    width: min(440px, 90vw);
    align-items: center;
    justify-content: center;
    gap: 24px;
    justify-self: center;
    margin-bottom: 42px;
    padding: 20px 36px;
    border: 1px solid var(--glass-border);
    border-radius: 38px;
    background: linear-gradient(145deg, var(--glass-hover), var(--glass));
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 18px 34px var(--glass-shadow);
    backdrop-filter: blur(20px) saturate(140%);
  }

  .social-dock a {
    display: grid;
    width: 56px;
    height: 56px;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 18px;
    color: var(--orange);
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  :global(:root[data-theme='dark']) .social-dock a { color: var(--orange-deep); }

  .social-dock a:hover {
    border-color: var(--glass-border);
    background: var(--glass-hover);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 10px 20px var(--glass-shadow);
    transform: translateY(-4px) scale(1.035);
  }

  .social-dock svg { width: 56px; height: 56px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 4.2; }
  .social-dock .filled-icon { fill: currentColor; stroke: none; }
  .contact-footer { display: flex; align-items: center; justify-content: center; gap: 30px; color: var(--muted); font-size: 17px; }
  .contact-footer a { transition: color 180ms ease, text-shadow 180ms ease; }
  .contact-footer a:hover { color: var(--ink); text-shadow: 0 4px 14px var(--glass-shadow); }

  @media (max-width: 1020px) {
    .about-screen { padding-right: 38px; padding-left: 38px; }
    .index-screen { flex-direction: column; gap: 0; text-align: center; }
    .index-screen p { margin-top: 22px; }
  }

  @media (max-width: 780px) {
    .single-page { width: 100%; margin-inline: 0; }
    .page-section { scroll-margin-top: 124px; }
    .index-screen { padding: 100px 24px 40px; }
    .index-screen h1 { max-width: 100%; font-size: clamp(48px, 12.5vw, 72px); line-height: .98; white-space: normal; }
    .index-screen p { font-size: 16px; white-space: normal; }
    .about-screen { padding: 168px 18px 40px; }
    .about-header h2 { font-size: clamp(58px, 15vw, 86px); }
    .about-header > p { margin-bottom: 34px; font-size: clamp(18px, 5vw, 28px); }
    .contacts-screen { padding: 160px 18px 24px; }
    .contacts-header h2 { font-size: clamp(65px, 18vw, 88px); }
    .contacts-header p { font-size: 14px; }
    .contact-footer { gap: 12px; font-size: 12px; }
    .contact-footer span { max-width: 82px; overflow: hidden; white-space: nowrap; }
  }
</style>
