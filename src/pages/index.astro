---
import AboutTabs from '@/components/AboutTabs.astro';
import PageShell from '@/components/PageShell.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';

const socials = [
  { label: 'Email', href: `mailto:${site.email}`, icon: 'mail' },
  { label: 'LinkedIn', href: site.social.find((item) => item.label === 'LinkedIn')?.href ?? '#', icon: 'linkedin' },
  { label: 'GitHub', href: site.social.find((item) => item.label === 'GitHub')?.href ?? '#', icon: 'github' },
  { label: 'Telegram', href: site.social.find((item) => item.label === 'Telegram')?.href ?? '#', icon: 'telegram' },
];
---

<BaseLayout>
  <PageShell>
    <main class="single-page" id="main">
      <section class="index-screen page-section" id="index" data-page-section="index">
        <h1>Hi, It’s Dmitrii</h1>
        <p><span aria-hidden="true">//</span> {site.role}</p>
      </section>

      <section class="about-screen page-section" id="about" data-page-section="about">
        <header class="about-header">
          <h2>{site.role}</h2>
          <div class="rule-title" aria-hidden="true"><span>//</span><span class="rule-line">------------------------------------------------------------</span><span>\\</span></div>
          <p>building reliable data systems end-to-end</p>
        </header>
        <AboutTabs />
      </section>

      <section class="contacts-screen page-section" id="contacts" data-page-section="contacts">
        <header class="contacts-header">
          <h2>Contacts</h2>
          <div class="rule-title" aria-hidden="true"><span>//</span><span class="rule-line">------------------------------------------------------------</span><span>\\</span></div>
          <p>Have a question or want to work together? I’d love to hear from you.</p>
        </header>

        <nav class="social-dock" aria-label="Contact links" data-liquid-glass="clear">
          {socials.map((item) => (
            <a href={item.href} target={item.icon === 'mail' ? undefined : '_blank'} rel={item.icon === 'mail' ? undefined : 'noreferrer'} aria-label={item.label}>
